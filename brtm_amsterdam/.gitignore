# BRTM Amsterdam .gitignore

# Data files
data/raw/*
data/crawled/*
data/processed/*
!data/raw/.gitkeep
!data/crawled/.gitkeep
!data/processed/.gitkeep

# Cache and results
cache/*
results/*
!cache/.gitkeep
!results/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.bak
